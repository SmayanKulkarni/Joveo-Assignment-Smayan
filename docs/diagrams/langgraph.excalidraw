      "updated": 1793625081791,
      "link": null,
      "locked": false,
      "text": "AsyncPostgresSaver writes the whole state after every super-step (durability=\"sync\"), so a Run resumes exactly at any Pause, even after a restart\nAsyncPostgresStore · runs registry · csms · customers · resumes · customer_profiles",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AsyncPostgresSaver writes the whole state after every super-step (durability=\"sync\"), so a Run resumes exactly at any Pause, even after a restart\nAsyncPostgresStore · runs registry · csms · customers · resumes · customer_profiles",
      "autoResize": true,
      "lineHeight": 1.35
    },
